PAPER_ENV=production
PAPER_APP_NAME=PaperKnowKnow

# Web server binding
PAPER_HOST=0.0.0.0
PAPER_PORT=8000
PAPER_OPEN_BROWSER=false
PAPER_DESKTOP_MODE=false

# Data storage (optional)
# PAPER_DATA_DIR=/srv/paperknowknow/data

# Upload / rate limit
PAPER_MAX_UPLOAD_MB=50
PAPER_RATE_LIMIT_CALLS=30
PAPER_RATE_LIMIT_WINDOW_SEC=60

# Public deployment
# Comma-separated list, for example:
# PAPER_CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com
PAPER_CORS_ORIGINS=

# Trusted hosts, for example:
# PAPER_TRUSTED_HOSTS=your-domain.com,www.your-domain.com
PAPER_TRUSTED_HOSTS=*
